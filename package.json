{
  "name": "larpedin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Genuine news. Satirical takes. A fast, independent satire.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun run --filter @larpedin/web dev",
    "dev:news": "bun run --filter @larpedin/news dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
