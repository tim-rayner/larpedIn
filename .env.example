# Optional process environment. Set these in your shell or hosting platform.
HOST=127.0.0.1
PORT=3000

# Server-only live news generation. Copy this file to .env and add your key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TECH_NEWS_ENABLED=true
# Feature flag: set to true to show the news publisher's name, links and images' source. Hidden by default.
SHOW_NEWS_SOURCE=false
TECH_NEWS_RSS_URL=https://techcrunch.com/feed/
TECH_NEWS_PAGE_SIZE=6
TECH_NEWS_MAX_ITEMS=36
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=