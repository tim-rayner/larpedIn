{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowJs": false
  },
  "include": ["apps/news/**/*.ts", "packages/shared/**/*.ts"],
  "exclude": ["node_modules"]
}
