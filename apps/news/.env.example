# News service environment. Bun loads .env from the directory it runs in (apps/news).
PORT=3001

# Shared secret for POST /refresh. The GitHub Actions workflow sends it as a bearer token.
REFRESH_SECRET=

# Satire generation. Without a key every Post uses factual fallback copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

TECH_NEWS_ENABLED=true
TECH_NEWS_RSS_URL=https://techcrunch.com/feed/
TECH_NEWS_MAX_ITEMS=36

# Edition store (Upstash Redis, free tier). Unset = in-memory, dev only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image store (Cloudflare R2, free tier, S3-compatible). Unset = in-memory, dev only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
