# Web app environment. Bun loads .env from the directory it runs in (apps/web).
HOST=127.0.0.1
PORT=3000

# Base URL of the news service. Unset = the bundled house edition is shown.
NEWS_SERVICE_URL=http://127.0.0.1:3001

# Bearer token the news service requires for reads. Must match NEWS_SERVICE_TOKEN in apps/news.
NEWS_SERVICE_TOKEN=

# Feature flag: set to true to show the news publisher's name, links and images' source. Hidden by default.
SHOW_NEWS_SOURCE=false
